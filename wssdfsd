b.MouseButton1Click:Connect(function()
    enabled = not enabled
    if enabled then
        b.Text = "ВКЛ"
        b.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        if DEBUG then print("[FTAP] ON") end
    else
        b.Text = "ВЫКЛ"
        b.BackgroundColor3 = Color3.fromRGB(50, 55, 70)
        if isActuallyHolding() then releaseMouse() end
        if DEBUG then print("[FTAP] OFF") end
    end
