task.spawn(function()
    while gui.Parent do
        if enabled then
            if isActuallyHolding() then
                status.Text = "Статус: ДЕРЖУ"
                status.TextColor3 = Color3.fromRGB(80, 220, 120)
            else
                local tgt = targetUnderCrosshair()
                if tgt then
                    status.Text = "Статус: цель " .. tgt.Name
                    status.TextColor3 = Color3.fromRGB(220, 180, 80)
                else
                    status.Text = "Статус: жду цель"
                    status.TextColor3 = Color3.fromRGB(150, 170, 210)
                end
            end
        else
            status.Text = "Статус: выкл"
            status.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        task.wait(0.15)
    end
end)

print("[FTAP Trigger] загружен")
