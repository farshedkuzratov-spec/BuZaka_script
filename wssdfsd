-- ============================================================
-- FTAP Trigger Bot — читает состояние граба из игры
-- ============================================================
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS        = game:GetService("UserInputService")
local VIM        = game:GetService("VirtualInputManager")
local LP         = Players.LocalPlayer
local Cam        = workspace.CurrentCamera

-- ===== Настройки =====
local MAX_DIST        = 60
local ANGLE           = math.rad(8)
local REGRAB_COOLDOWN = 0.2    -- пауза после отпускания, чтобы не схватить мгновенно
local DEBUG           = true   -- печатать в консоль что происходит

-- ===== Состояние =====
local enabled       = false
local lastRelease   = 0
local lastGrabTry   = 0
local wasHolding    = false

-- ============================================================
-- ГЛАВНОЕ: определяем реально ли мы держим что-то, через игру
-- ============================================================
local function isActuallyHolding()
    -- Вариант 1: папка GrabParts существует → мы держим линию
    if workspace:FindFirstChild("GrabParts") then
        return true
    end

    -- Вариант 2: у нас есть weld на часть с "PartOwner" == наш ник
    local char = LP.Character
    if char then
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("BasePart") then
                local owner = obj:FindFirstChild("PartOwner")
                if owner and owner:IsA("StringValue") and owner.Value == LP.Name then
                    return true
                end
            end
        end
    end

    return false
end

-- ============================================================
-- Поиск цели под прицелом
-- ============================================================
local function targetUnderCrosshair()
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local camPos  = Cam.CFrame.Position
    local lookVec = Cam.CFrame.LookVector

    local best, bestA = nil, ANGLE

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum  = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part then
                local dist = (part.Position - camPos).Magnitude
                if dist <= MAX_DIST then
                    local dir = (part.Position - camPos).Unit
                    local a   = math.acos(math.clamp(lookVec:Dot(dir), -1, 1))
                    if a < bestA then
                        bestA = a
                        best  = plr
                    end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- Нажатие ЛКМ (несколько способов на всякий случай)
-- ============================================================
local function pressMouse()
    local vp = Cam.ViewportSize
    local cx, cy = math.floor(vp.X / 2), math.floor(vp.Y / 2)

    pcall(function() VIM:SendMouseMoveEvent(cx, cy, game) end)
    pcall(function() VIM:SendMouseButtonEvent(cx, cy, 0, true, game, 0) end)
    pcall(function() mouse1press() end)
end

local function releaseMouse()
    local vp = Cam.ViewportSize
    local cx, cy = math.floor(vp.X / 2), math.floor(vp.Y / 2)

    pcall(function() VIM:SendMouseButtonEvent(cx, cy, 0, false, game, 0) end)
    pcall(function() mouse1release() end)
end

-- ============================================================
-- Основной цикл — читаем состояние ИЗ ИГРЫ каждый кадр
-- ============================================================
RunService.RenderStepped:Connect(function()
    if not enabled then return end

    local now = tick()
    local holding = isActuallyHolding()

    -- Если только что перестали держать (игра убрала GrabParts)
    if wasHolding and not holding then
        lastRelease = now
        if DEBUG then print("[FTAP] Обнаружено отпускание → cooldown") end
    end
    wasHolding = holding

    -- Уже держим — ничего не делаем
    if holding then return end

    -- Кулдаун после отпускания чтобы не схватить сразу того же
    if (now - lastRelease) < REGRAB_COOLDOWN then return end

    -- Кулдаун между попытками захвата
    if (now - lastGrabTry) < 0.1 then return end

    -- Есть цель под прицелом → пробуем схватить
    local t = targetUnderCrosshair()
    if t then
        lastGrabTry = now
        pressMouse()
        if DEBUG then
            print("[FTAP] GRAB на " .. t.Name)
        end
    end
end)

-- ============================================================
-- Страховка: если скрипт выключен — отпустить
-- ============================================================
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    -- ПКМ (бросок) — можно не трогать, игра сама отпустит
end)

